[sub_resource type="Shader" id="Shader_yf02v"]
code = "shader_type canvas_item;

uniform vec2 texture_size;


void fragment() {
	if (float(int(((UV.x-TIME/25.0)*texture_size.x)+(UV.y*texture_size.y))&30) > 15.0) {
		if (COLOR.a != 0.0) {
			COLOR = vec4(0.0, 0.0, 0.0, 1.0);
		}
	}
}
"

