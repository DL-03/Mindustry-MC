[sub_resource type="Shader" id="Shader_xabsi"]
code = "shader_type canvas_item;

uniform vec2 object_size;
uniform vec2 text_size;
uniform int text_vertical_aligment;

void vertex() {
	if (text_vertical_aligment == 1) {
		VERTEX.y += object_size.y/2.0-text_size.y/2.0;
	}
	if (text_vertical_aligment == 2) {
		VERTEX.y += object_size.y-text_size.y;
	}
}

void fragment() {
	// Called for every pixel the material is visible on.
}

//void light() {
	// Called for every pixel for every light affecting the CanvasItem.
	// Uncomment to replace the default light processing function with this one.
//}
"

