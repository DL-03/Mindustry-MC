; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mindustry Mod Construct"
config/version="0.3.0"
config/tags=PackedStringArray("123")
run/main_scene="res://scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Mindustry Mod Construct"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.145098, 0.145098, 0.145098, 1)
boot_splash/show_image=false
boot_splash/image="uid://c4xng0c0jh701"
config/icon="res://resources/MMC_ICON.png"
config/windows_native_icon="res://resources/MMC_ICON.ico"

[autoload]

PropertiesReader="*res://libs/PropertiesReader.gd"
COLORS="*res://libs/COLORS.gd"
SaveDataAPI="*res://libs/SaveDataAPI.gd"
LocalizationAPI="*uid://dblqn1jfxabv1"
Notifications="*uid://cdltj63vp0i8n"
OpenMod="*uid://cabtoljtxhmwc"
ContentManager="*res://libs/ContentManager.gd"
HJSON="*res://libs/HjsonMain.gd"
FileOperations="*res://libs/FileOperations.cs"
ModManager="*res://Scripts/ModManager.gd"
MindTooltipManager="*uid://cnf4srh20tt7f"
ArchiveMain="*res://libs/ArchiveMain.gd"

[debug]

settings/profiler/max_functions=41334
file_logging/enable_file_logging=true
settings/gdscript/max_call_stack=2047

[display]

window/hdr/request_hdr_output=true
window/energy_saving/keep_screen_on=false
display_server/driver.linuxbsd="wayland"
window/vsync/vsync_mode=0
window/ios/allow_high_refresh_rate=false

[dotnet]

project/assembly_name="Mindustry Mod Construct"
project/assembly_reload_attempts=5

[editor]

movie_writer/disable_vsync=true
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[file_customization]

folder_colors={
"res://libs/": "yellow",
"res://scenes/": "teal",
"res://widgets/": "orange"
}

[gui]

theme/default_font_antialiasing=2

[internationalization]

locale/locale_filter_mode=0

[memory]

limits/message_queue/max_size_mb=64

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.145098, 0.145098, 0.145098, 1)
