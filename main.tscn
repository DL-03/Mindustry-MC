[sub_resource type="GDScript" id="GDScript_sdbcl"]
script/source = "extends Button


# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	pass


func _on_pressed():
	var AllTabButtons = $/root/Main/V1/HBoxContainer/Panel/MarginContainer/ScrollContainer/MarginContainer2/HBoxContainer
	#if AllTabButtons.get_child_count() > 0
	var s = preload(\"res://TabMod_Button.tscn\")
	var k = s.instantiate()
	AllTabButtons.add_child(k)
"

[sub_resource type="GDScript" id="GDScript_ogj7x"]
script/source = "extends Button


# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	pass


func _on_pressed():
	var AllTabButtons = $/root/Main/V1/HBoxContainer/Panel/MarginContainer/ScrollContainer/MarginContainer2/HBoxContainer
	
	if AllTabButtons.get_child_count() == 1:
		if AllTabButtons.get_child(0).ContentFrame == null:
			return
		else:
			pass

	for i in AllTabButtons.get_children():
		if i.disabled:
			if i.ContentFrame == null:
				
				
				i.free()
				AllTabButtons.get_children()[-1].pressed.emit()
			else:
				var err = i.ContentFrame.Close()
				if err == 1:
					pass
				else:
					pass
					
				
				if AllTabButtons.get_child_count() == 1:
					i.reset()
					$/root/Main/V1/ModManager.show()
				else:
					i.free()
					AllTabButtons.get_children()[-1].pressed.emit()
					
					
				
			
			break
"

